# Example env for MySQL (replace values)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:@localhost:3306/usp_marketplace
DB_SSL=VERIFY_CA
DB_SSL_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Deployment
DEBUG=0
DJANGO_ALLOWED_HOSTS=.vercel.app,your-backend-domain.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://usp-market-place.vercel.app
CSRF_TRUSTED_ORIGINS=https://usp-market-place.vercel.app

# Email verification. Set these to your SMTP provider to send real emails.
# Without EMAIL_HOST, verification codes are printed in the backend terminal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com
EMAIL_TIMEOUT=20

# Microsoft Entra ID / USP SSO
MICROSOFT_CLIENT_ID=your-entra-application-client-id
MICROSOFT_TENANT_ID=your-usp-tenant-id
