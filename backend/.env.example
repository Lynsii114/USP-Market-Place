SECRET_KEY=replace-with-a-unique-random-secret
# Local development only; set DEBUG=false in Railway.
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,[::1],testserver
DATABASE_MODE=local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_DATABASE=usp_marketplace
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=
# Railway: set DATABASE_MODE=railway, DEBUG=false and your real domains in
# Railway Variables. DB_* values below are placeholders, not local overrides.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_DATABASE=your-mysql-database
DB_PASSWORD=
ADMIN_EMAIL=Admin@usp.ac.fj
ADMIN_PASSWORD=replace-with-a-strong-password
AUTO_ENSURE_SCHEMA=1
# Local development uses Gmail SMTP. Use a Google account with SMTP access and
# an app password; keep its value private in backend/.env.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your-google-workspace-address@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="USP Marketplace <your-google-workspace-address@example.com>"
EMAIL_TIMEOUT=20

# Railway production uses Resend HTTPS and ignores the SMTP settings above.
# Supply the real API key privately; never use VITE_* or commit it.
# The sender must use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=USP Marketplace <no-reply@your-verified-domain.example>
FRONTEND_URL=http://localhost:5173
# On Railway use FRONTEND_URL=https://usp-market-place.vercel.app
