# Local development
DEBUG=1
# Production: DEBUG=0, a unique SECRET_KEY, and a strong ADMIN_PASSWORD are required.
# ADMIN_EMAIL=Admin@usp.ac.fj
# ADMIN_PASSWORD=replace-with-a-strong-secret
# SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/usp_marketplace
AUTO_ENSURE_SCHEMA=1
LOCAL_DB_SYNC=0
LOCAL_DB_SYNC_ON_START=0
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=10
DB_WRITE_TIMEOUT=10
DB_CONN_MAX_AGE=60

# Aiven MySQL / Vercel production uses these instead of DATABASE_URL:
# DB_HOST=your-aiven-mysql-host
# DB_PORT=your-aiven-mysql-port
# DB_DATABASE=your-aiven-database-name
# DB_USERNAME=your-aiven-username
# DB_PASSWORD=your-aiven-password
# DB_SSL=VERIFY_CA
# DB_SSL_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Deployment
# DEBUG=0
# AUTO_ENSURE_SCHEMA=0
# DJANGO_ALLOWED_HOSTS=.vercel.app,your-backend-domain.vercel.app
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://usp-market-place.vercel.app
# CORS_ALLOWED_ORIGIN_SUFFIXES=.vercel.app
# CSRF_TRUSTED_ORIGINS=https://usp-market-place.vercel.app

# Email verification. Set these to your SMTP provider to send real emails.
# Without EMAIL_HOST, verification codes are printed in the backend terminal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com
EMAIL_TIMEOUT=20

# Microsoft Entra ID / USP SSO
MICROSOFT_CLIENT_ID=your-entra-application-client-id
MICROSOFT_TENANT_ID=your-usp-tenant-id
